{
  "name": "sales-electron",
  "private": true,
  "version": "1.0.0",
  "description": "Sales and inventory desktop app",
  "author": "Sales Electron",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "run-p dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && electron .",
    "build": "tsc -b && npm run transpile:electron && vite build",
    "pack:win": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run pack:win",
    "preview": "vite preview",
    "transpile:electron": "tsc -p tsconfig.electron.json && node --input-type=module -e \"import fs from 'fs'; fs.cpSync('src/electron/db/migrations','dist-electron/electron/db/migrations',{recursive:true}); fs.copyFileSync('src/electron/preload.cjs','dist-electron/electron/preload.cjs'); try { fs.unlinkSync('dist-electron/electron/preload.js'); } catch {} try { fs.unlinkSync('dist-electron/electron/preload.js.map'); } catch {}\"",
    "transpile:electron:watch": "tsc -p tsconfig.electron.json --watch",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "npm run transpile:electron && electron scripts/db-seed.mjs",
    "db:generate-schema": "node scripts/generate-schema-sql.mjs",
    "db:verify": "npm run transpile:electron && electron scripts/verify-schema-electron.mjs",
    "db:verify-auth": "npm run transpile:electron && electron scripts/verify-auth-electron.mjs",
    "verify:tax-rules": "npm run transpile:electron && node scripts/verify-tax-rules.mjs",
    "verify:tax-schema": "npm run transpile:electron && electron scripts/verify-tax-schema-electron.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.sales-electron.app",
    "productName": "Sales Electron",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-react/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sales Electron"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.24.0",
    "preact": "^10.29.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
